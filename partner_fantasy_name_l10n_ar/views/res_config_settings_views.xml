<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.partner.fantasy.name.l10n.ar</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="l10n_ar_print_fantasy_name" company_dependent="1"
                         help="Print the customer's fantasy name below their legal name on Argentinean invoices.">
                    <field name="l10n_ar_print_fantasy_name"/>
                </setting>
                <setting id="l10n_ar_print_delivery_address" company_dependent="1"
                         help="Print the delivery address on Argentinean customer invoices when it differs from the invoice address.">
                    <field name="l10n_ar_print_delivery_address"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
