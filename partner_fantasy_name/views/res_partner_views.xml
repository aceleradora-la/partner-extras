<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_fantasy_name" model="ir.ui.view">
        <field name="name">res.partner.form.fantasy.name</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Own labeled row right above the Address block, independent of
                 what localizations (e.g. l10n_ar) do with the vat field. -->
            <xpath expr="//span[@name='address_name']" position="before">
                <field name="fantasy_name"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_fantasy_name" model="ir.ui.view">
        <field name="name">res.partner.select.fantasy.name</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <!-- The default "Name" search already matches the fantasy name:
                 it searches display_name, which relies on _rec_names_search. -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="fantasy_name"/>
            </xpath>
        </field>
    </record>

</odoo>
