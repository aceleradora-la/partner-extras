<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_order_filter_fantasy_name" model="ir.ui.view">
        <field name="name">sale.order.list.select.fantasy.name</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_fantasy_name" string="Fantasy Name"/>
            </xpath>
        </field>
    </record>

</odoo>
